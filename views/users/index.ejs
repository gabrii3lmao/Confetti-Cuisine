<h2>Users Table</h2>
<table class="table">
  <h3><a href="/users/new">Create a new User</a></h3>
  <thead>
    <tr>
      <th>Name</th>
      <th>Email</th>
      <th>Zip Code</th>
      <th>Name Length</th>
      <th>Edit</th>
      <th>Delete</th>
    </tr>
  </thead>
  <tbody>
    <% users.forEach(user => { %>
    <tr>
      <td>
        <a href="<%=`/users/${user.id}` %>"> <%= user.fullName%> </a>
      </td>
      <td><%= user.email %></td>
      <td><%= user.zipCode%></td>
      <td><%= user.userNameLength%></td>
      <td>
        <a href="<%= `/users/${user.id}/edit` %>"> Edit </a>
      </td>
      <td>
        <form
          action="/users/<%= user.id %>/delete?_method=DELETE"
          method="POST"
          onsubmit="return confirm('Are you sure you want to delete this user?')"
        >
          <button type="submit">Delete</button>
        </form>
      </td>
    </tr>
    <% }); %>
  </tbody>
</table>
