<h2>Users Table</h2>
<table class="table">
  <h3><a href="/users/new">Create a new User</a></h3>
  <thead>
    <tr>
      <th>Name</th>
      <th>Email</th>
      <th>Zip Code</th>
      <th>Name Length</th>
    </tr>
  </thead>
  <tbody>
    <% users.forEach(user => { %>
    <tr>
      <td>
        <a href="<%=`/users/${user.id}` %>"> <%= user.fullName%> </a>
      </td>
      <td><%= user.email %></td>
      <td><%= user.zipCode%></td>
      <td><%= user.userNameLength%></td>
    </tr>
    <% }); %>
  </tbody>
</table>
