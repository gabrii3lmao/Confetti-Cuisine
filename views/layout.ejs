<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>confetti_cuisine</title>
    <link rel="stylesheet" href="/css/confetti_cuisine.css" />
  </head>
  <body>
    <div id="wrapper">
      <header id="header">
        <h1>Confetti Cuisine</h1>
        <p>Learning with flavor</p>
      </header>

      <div class="flashes">
        <% if (flashMessages) { %> <% if (flashMessages.success) { %> <%
        flashMessages.success.forEach(msg => { %>
        <div class="flash success"><%= msg %></div>
        <% }) %> <% } %> <% if (flashMessages.error) { %> <%
        flashMessages.error.forEach(msg => { %>
        <div class="flash error"><%= msg %></div>
        <% }) %> <% } %> <% } %>
      </div>

      <nav id="menu">
        <a href="/">Home</a>
        <a href="/courses">Courses</a>
        <a href="/courses/new"> Create Course </a>
        <a href="/contact">Contact</a>
        <a href="/subscribers"> Subscribers </a>
        <a href="/users">Users</a>
      </nav>

      <main id="content"><%- body %></main>

      <footer id="footer">© 2025 Confetti Cuisine | gabrii3lmao</footer>
    </div>
  </body>
</html>
